{
  "name": "agent-ego-engine",
  "version": "1.0.0",
  "type": "module",
  "description": "Autonomous Human Temperament & Perfectionist Self-Critique Engine for AI Agents",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agent-ego": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs = require('fs'); fs.cpSync('src/dashboard/ui.html', 'dist/dashboard/ui.html', { force: true });\"",
    "start": "tsx src/cli.ts",
    "test": "tsx --test \"test/ego-loop.test.ts\" \"test/auto-fixer.test.ts\" \"test/profession-spec.test.ts\" \"test/calibration.test.ts\" \"test/universal-synthesizer.test.ts\" \"test/multi-persona-colosseum.test.ts\""
  },




  "keywords": [
    "ai-agents",
    "code-quality",
    "gatekeeper",
    "typescript",
    "cli",
    "antigravity",
    "cursor-rules",
    "ast-fixer",
    "axe-core",
    "playwright"
  ],

  "author": "Kapitan",
  "license": "MIT",
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "chokidar": "^5.0.0",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1",
    "playwright": "^1.50.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
